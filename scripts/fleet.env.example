# Lattice fleet config — operator-local values for the ops scripts
# (deploy-fleet.sh, fleet-sync.sh, fleet-watchdog.sh).
#
# Copy this to scripts/fleet.env (gitignored) and fill in YOUR values.
# Keeping the tailnet hostname + machine map out of the tracked repo is what
# lets this repo stay public without leaking your mesh's identity.
#
#   cp scripts/fleet.env.example scripts/fleet.env && $EDITOR scripts/fleet.env

# The hub's tailnet (or LAN) host:port that agents dial to enroll.
LATTICE_HUB_TS="host-a.your-tailnet.ts.net:7400"

# The hub's local URL on the hub host itself (used for health checks).
LATTICE_HUB_LOCAL="http://localhost:7400"

# The agent-backed machines to deploy/sync, as "ssh_alias:lattice_name:os".
# ssh_alias = the Host in your ~/.ssh/config; lattice_name = the --name the
# agent enrolls under; os = darwin | windows | linux. The hub host itself is
# handled separately (it isn't pushed over SSH), so don't list it here.
LATTICE_FLEET=(
  "host-a:node-a:darwin"
  "host-b:node-b:windows"
)

# ntfy topic the watchdog pushes recovery/alert pings to (your phone subscribes
# here). Pick an unguessable string; leave empty to disable push alerts.
LATTICE_NTFY_TOPIC="your-ntfy-topic"

# Watchdog: which machine NAMES (as the hub reports them) to actively guard.
# Only always-on boxes belong here (laptops/phones flap → false alerts).
LATTICE_WD_WATCH="node-a"
